# Anonymous visit statistics (src/stats.ts), read at build time by
# `npm run build`. Copy to .env to try them locally; leave them unset (the
# default) and no statistics are sent at all: local development, forks and
# tests stay silent. See docs/DEPLOYMENT.md, "Statistics".
# In GitHub Actions they come from the repository's variables (not secrets).

# The Umami server (https only), without /api/send.
PUBLIC_UMAMI_HOST=https://stats.example
# The website id of the site's own pages (sysadmin.rouages.net).
PUBLIC_UMAMI_SITE_ID=
# The website id of the game embedded in other sites (dist/integration/).
PUBLIC_UMAMI_EMBED_ID=

# Sysadmin Quests — Apache configuration (cPanel), sysadmin.rouages.net
# Taken from rouages.net, plus the CORS header of the file to embed, and the
# language chosen at the root.

Options -Indexes
ErrorDocument 404 /404.html

# HTTPS obligatoire
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The French pages used to be at the root: they now live under /fr/.
  RewriteRule ^enseignants/?$ /fr/enseignants/ [L,R=301]
  RewriteRule ^enseignants/classe/?$ /fr/enseignants/classe/ [L,R=301]

  # The root picks a language from the browser (Accept-Language): French when
  # the first language asked for is French, English otherwise. 302, so that
  # the choice is made again on each visit (and by each browser).
  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^$ /fr/ [L,R=302]
  RewriteRule ^$ /en/ [L,R=302]
</IfModule>

# Ne pas exposer l'état de synchronisation du déploiement FTP
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Cache : fichiers versionnés d'Astro = 1 an ; HTML et fichier à intégrer
  # (son nom ne change pas d'une version à l'autre) = toujours revalider
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Le fichier d'intégration est chargé par d'autres sites : un script
  # « module » venu d'une autre origine exige l'en-tête CORS.
  <If "%{REQUEST_URI} =~ m#^/integration/#">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The root's answer depends on the browser's language: caches must know.
  <If "%{REQUEST_URI} == '/'">
    Header always merge Vary "Accept-Language"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Aucune ressource tierce : tout vient du site. Styles en ligne permis
  # (Astro insère les petites feuilles, le jeu les siennes dans son Shadow DOM).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Quêtes de Sysadmin — configuration Apache (cPanel), sysadmin.rouages.net
# Reprise de rouages.net, plus l'en-tête CORS du fichier à intégrer.

Options -Indexes
ErrorDocument 404 /404.html

# HTTPS obligatoire
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Ne pas exposer l'état de synchronisation du déploiement FTP
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Cache : fichiers versionnés d'Astro = 1 an ; fichier à intégrer (nom
  # fixe) = 1 heure ; HTML = toujours revalider
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/integration/#">
    Header set Cache-Control "public, max-age=3600"
    # Un <script type="module"> chargé depuis un autre site exige CORS.
    Header set Access-Control-Allow-Origin "*"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Aucune ressource tierce : tout vient du site. Styles en ligne permis
  # (Astro insère les petites feuilles, le jeu les siennes dans son Shadow DOM).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

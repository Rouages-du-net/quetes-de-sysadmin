### Les noms des machines du réseau simulé : celui qu'on tape (ssh royaume),
### l'invite (vous@royaume), /etc/hosts, ~/.ssh/config, les clés
### (~/.ssh/id_royaume), /etc/hostname. L'identifiant du moteur est le
### nom anglais ; chaque langue donne un nom de machine valide : minuscules,
### chiffres et tirets, sans accent ni espace (RFC 1123), facile à taper.

machine-desk = poste
machine-kingdom = royaume
machine-datacenter = datacenter
machine-anthill = fourmiliere
machine-manuscript = manuscrit
machine-library = bibliotheque
machine-letters = lettres
machine-workshop = fabrique
machine-gazette = gazette
machine-games = ludotheque

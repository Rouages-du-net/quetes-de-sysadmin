man-Set-ADOrganizationalUnit = changes an organizational unit (its protection, its description).
    .synopsis = Set-ADOrganizationalUnit [-Identity] <Object> [-ProtectedFromAccidentalDeletion <Boolean>] [-Description <String>] [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-ProtectedFromAccidentalDeletion = $true or $false.
    .option-Description = a description.
    .option-PassThru = return the OU.
    .example-1 = before removing it
man-Remove-ADOrganizationalUnit = deletes an organizational unit: refused ("Access is denied") while it is protected, and only empty unless -Recursive.
    .synopsis = Remove-ADOrganizationalUnit [-Identity] <Object> [-Recursive] [-Confirm]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Recursive = with what it contains.
    .example-1 = what would go
man-Move-ADObject = moves an object (a user, a computer, a group, an OU) to another container: its DN changes, and so do the GPOs that apply to it. A protected object refuses ("Access is denied").
    .synopsis = Move-ADObject [-Identity] <Object> [-TargetPath] <String> [-PassThru]

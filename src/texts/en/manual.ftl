man-Set-ADUser = changes domain users (named, or from the pipeline): their attributes by parameter, or by LDAP name with -Replace @{"{"}title='Pilot'{"}"} and -Clear.
    .synopsis = Set-ADUser [-Identity] <Object> [-Department <String>] [-Title <String>] [-Manager <Object>] [-Enabled <Boolean>] [-Replace <Hashtable>] [-Clear <String[]>] [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-GivenName = the first name.
    .option-Surname = the last name.
    .option-DisplayName = the name shown.
    .option-Description = a description.
    .option-Department = the department.
    .option-Title = the job title.
    .option-Office = the office.
    .option-Company = the company.
    .option-EmailAddress = the e-mail address.
    .option-UserPrincipalName = the logon name with the domain (alice@harbour.internal).
    .option-SamAccountName = the logon name (alice).
    .option-Enabled = $true or $false.
    .option-PasswordNeverExpires = $true for an account whose password never expires.
    .option-CannotChangePassword = $true: the user may not change it.
    .option-ChangePasswordAtLogon = $true: a new password at the next logon.
    .option-AccountExpirationDate = when the account expires.
    .option-Manager = the manager (an identity).
    .option-Replace = LDAP attributes to set (@{"{"}department='Office'{"}"}).
    .option-Add = LDAP attributes to add.
    .option-Clear = LDAP attributes to empty.
    .option-PassThru = return the user.
    .example-1 = a promotion
    .example-2 = everyone of a department
man-Remove-ADUser = deletes domain users; it asks first (-Confirm:$false not to). Disabling (Disable-ADAccount) is usually wiser: the SID, and the permissions given to it, can't come back.
    .synopsis = Remove-ADUser [-Identity] <Object> [-Confirm]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .example-1 = what would go
man-Enable-ADAccount = enables user or computer accounts.
    .synopsis = Enable-ADAccount [-Identity] <Object> [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-PassThru = return the account.
    .example-1 = back from leave
man-Disable-ADAccount = disables user or computer accounts: they can no longer log on, but keep their SID and groups.
    .synopsis = Disable-ADAccount [-Identity] <Object> [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-PassThru = return the account.
    .example-1 = the accounts nobody used for 90 days
man-Unlock-ADAccount = unlocks an account locked out by too many wrong passwords (the domain's lockout threshold); its bad password count starts again from 0. Find first what keeps sending the old password (event 4740's Caller Computer Name on the domain controller), or it locks again.
    .synopsis = Unlock-ADAccount [-Identity] <Object> [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-PassThru = return the account.
    .example-1 = who is locked out
    .example-2 = unlock
man-Set-ADAccountPassword = sets an account's password: -Reset as an administrator, or -OldPassword to change one's own. The domain's policy checks it. A reset doesn't unlock the account (Unlock-ADAccount does).
    .synopsis = Set-ADAccountPassword [-Identity] <Object> [-Reset] [-NewPassword <SecureString>] [-OldPassword <SecureString>]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Reset = set it without the old one.
    .option-NewPassword = the new one (SecureString).
    .option-OldPassword = the current one.
    .example-1 = a forgotten password
    .example-2 = and bob chooses his own at the next logon
man-Search-ADAccount = finds accounts by their state: locked out, disabled, inactive (no logon for 15 days, or -TimeSpan 90.00:00:00; never used counts), expired, expiring, password expired or never expiring.
    .synopsis = Search-ADAccount -LockedOut | -AccountDisabled | -AccountInactive [-TimeSpan <TimeSpan>] [-DateTime <DateTime>] | -AccountExpired | -AccountExpiring | -PasswordExpired | -PasswordNeverExpires [-UsersOnly] [-ComputersOnly] [-SearchBase <String>]
    .option-LockedOut = locked out.
    .option-AccountDisabled = disabled.
    .option-AccountInactive = no logon for a while.
    .option-TimeSpan = how long (days.hours:minutes:seconds).
    .option-AccountExpired = the account expired.
    .option-PasswordExpired = the password expired.
    .option-PasswordNeverExpires = a password that never expires.
    .option-UsersOnly = users only.
    .option-ComputersOnly = computers only.
    .option-SearchBase = under this DN.
    .example-1 = who is locked out
    .example-2 = forgotten accounts
man-New-ADGroup = creates a group. Microsoft's rule of thumb (AGDLP): accounts in Global groups by role, Global groups in Domain Local groups by resource, permissions given to the Domain Local groups.
    .synopsis = New-ADGroup [-Name] <String> [-GroupScope] <DomainLocal|Global|Universal> [-GroupCategory <Security|Distribution>] [-Path <String>] [-Description <String>] [-PassThru]
    .option-Name = its name.
    .option-GroupScope = Global, DomainLocal or Universal.
    .option-GroupCategory = Security (default) or Distribution (e-mail only, no permissions).
    .option-Path = the OU.
    .option-Description = a description.
    .option-PassThru = return the group.
    .example-1 = a group for a resource
man-Set-ADGroup = changes groups' attributes.
    .synopsis = Set-ADGroup [-Identity] <Object> [-Description <String>] [-Replace <Hashtable>] [-Clear <String[]>] [-PassThru]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Description = a description.
    .option-Replace = LDAP attributes to set.
    .option-Clear = LDAP attributes to empty.
    .option-PassThru = return the group.
    .example-1 = its description
man-Remove-ADGroup = deletes groups (it asks first).
    .synopsis = Remove-ADGroup [-Identity] <Object> [-Confirm]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .example-1 = what would go
man-Get-ADGroupMember = gets a group's members (users, computers, groups, and those whose primary group it is); -Recursive goes down the nested groups and returns the accounts reached.
    .synopsis = Get-ADGroupMember [-Identity] <Object> [-Recursive]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).

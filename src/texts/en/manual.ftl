man-Get-ADUser = gets domain users: by default DistinguishedName, Enabled, GivenName, Name, ObjectClass, ObjectGUID, SamAccountName, SID, Surname, UserPrincipalName; -Properties adds others (LockedOut, BadLogonCount, LastLogonDate, PasswordLastSet, MemberOf, Department, Manager…). -Filter takes the module's expression language (Name -like 'a*' -and Enabled -eq $false; * for every object; $variables are read from your session), -LDAPFilter an LDAP filter ((&(objectClass=user)(department=Office))). An identity that doesn't exist is a terminating error ("Cannot find an object with identity"), even with -ErrorAction SilentlyContinue.
    .synopsis = Get-ADUser [-Identity] <Object> | -Filter <String> | -LDAPFilter <String> [-SearchBase <String>] [-SearchScope <Base|OneLevel|Subtree>] [-Properties <String[]>]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Filter = a filter in the module's language (* for all).
    .option-LDAPFilter = an LDAP filter.
    .option-SearchBase = where to search (a DN).
    .option-SearchScope = Base, OneLevel or Subtree (default).
    .option-Properties = more properties (* for every one).
    .example-1 = why an account is refused
    .example-2 = the office, active accounts
    .example-3 = an LDAP filter under an OU
man-Get-ADComputer = gets the domain's computer accounts (DNSHostName, Enabled, the OU they are in; -Properties OperatingSystem, LastLogonDate, IPv4Address). A computer's identity may omit its final $.
    .synopsis = Get-ADComputer [-Identity] <Object> | -Filter <String> | -LDAPFilter <String> [-SearchBase <String>] [-SearchScope <Base|OneLevel|Subtree>] [-Properties <String[]>]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Filter = a filter in the module's language (* for all).
    .option-LDAPFilter = an LDAP filter.
    .option-SearchBase = where to search (a DN).
    .option-SearchScope = Base, OneLevel or Subtree (default).
    .option-Properties = more properties (* for every one).
    .example-1 = where each machine is
man-Get-ADGroup = gets domain groups: GroupScope (Global, DomainLocal, Universal), GroupCategory (Security, Distribution); -Properties Members, MemberOf, Description.
    .synopsis = Get-ADGroup [-Identity] <Object> | -Filter <String> | -LDAPFilter <String> [-SearchBase <String>] [-SearchScope <Base|OneLevel|Subtree>] [-Properties <String[]>]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Filter = a filter in the module's language (* for all).
    .option-LDAPFilter = an LDAP filter.
    .option-SearchBase = where to search (a DN).
    .option-SearchScope = Base, OneLevel or Subtree (default).
    .option-Properties = more properties (* for every one).
    .example-1 = who is in it, directly
    .example-2 = the domain local groups
man-Get-ADOrganizationalUnit = gets organizational units: their DN, name, the GPOs linked to them (LinkedGroupPolicyObjects); -Properties ProtectedFromAccidentalDeletion, Description.
    .synopsis = Get-ADOrganizationalUnit [-Identity] <Object> | -Filter <String> | -LDAPFilter <String> [-SearchBase <String>] [-SearchScope <Base|OneLevel|Subtree>] [-Properties <String[]>]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Filter = a filter in the module's language (* for all).
    .option-LDAPFilter = an LDAP filter.
    .option-SearchBase = where to search (a DN).
    .option-SearchScope = Base, OneLevel or Subtree (default).
    .option-Properties = more properties (* for every one).
    .example-1 = the tree of OUs
man-Get-ADObject = gets any object of the directory (users, groups, computers, OUs, containers): DistinguishedName, Name, ObjectClass, ObjectGUID. With -IncludeDeletedObjects, the objects of the AD Recycle Bin too (in CN=Deleted Objects, Deleted True, their LastKnownParent).
    .synopsis = Get-ADObject [-Identity] <Object> | -Filter <String> | -LDAPFilter <String> [-SearchBase <String>] [-SearchScope <Base|OneLevel|Subtree>] [-Properties <String[]>] [-IncludeDeletedObjects]
    .option-Identity = the object: its DN, GUID, SID or sAMAccountName (or objects from the pipeline).
    .option-Filter = a filter in the module's language (* for all).
    .option-LDAPFilter = an LDAP filter.
    .option-SearchBase = where to search (a DN).
    .option-SearchScope = Base, OneLevel or Subtree (default).
    .option-Properties = more properties (* for every one).
    .option-IncludeDeletedObjects = the deleted objects too (the Recycle Bin).
    .example-1 = what is directly in an OU
    .example-2 = what the Recycle Bin holds
man-New-ADUser = creates a domain user in an OU (CN=Users by default), disabled unless -Enabled $true with a password the domain's policy accepts (length, complexity: three kinds of characters, not the name). A refused password still leaves the account created, disabled.
    .synopsis = New-ADUser [-Name] <String> [-GivenName <String>] [-Surname <String>] [-SamAccountName <String>] [-UserPrincipalName <String>] [-Path <String>] [-AccountPassword <SecureString>] [-Enabled <Boolean>] [-ChangePasswordAtLogon <Boolean>] [-PassThru]
    .option-Name = its name (the CN).
    .option-Path = the OU (a DN).
    .option-AccountPassword = its password (SecureString).
    .option-PassThru = return the user.
    .option-GivenName = the first name.
    .option-Surname = the last name.
    .option-DisplayName = the name shown.
    .option-Description = a description.
    .option-Department = the department.
    .option-Title = the job title.
    .option-Office = the office.
    .option-Company = the company.
    .option-EmailAddress = the e-mail address.
    .option-UserPrincipalName = the logon name with the domain (alice@harbour.internal).
    .option-SamAccountName = the logon name (alice).
    .option-Enabled = $true or $false.
    .option-PasswordNeverExpires = $true for an account whose password never expires.
    .option-CannotChangePassword = $true: the user may not change it.
    .option-ChangePasswordAtLogon = $true: a new password at the next logon.
    .option-AccountExpirationDate = when the account expires.
    .option-Manager = the manager (an identity).

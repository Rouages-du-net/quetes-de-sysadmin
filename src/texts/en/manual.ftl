man-Set-GPLink = changes a GPO's link: enabled, enforced, its order.
    .synopsis = Set-GPLink [-Name] <String> | -Guid <Guid> [-Target] <String> [-LinkEnabled <Yes|No>] [-Enforced <Yes|No>] [-Order <Int32>]
    .option-Name = the GPO by its name.
    .option-Guid = the GPO by its id.
    .option-Target = the domain or the OU (a DN).
    .option-LinkEnabled = Yes or No: a disabled link applies nothing.
    .option-Enforced = Yes: the GPO wins over the ones linked below, and goes through blocked inheritance.
    .option-Order = the link order (1 wins over the others of the same container).
    .example-1 = nothing below overrides it
man-Remove-GPLink = removes a GPO's link (the GPO stays).
    .synopsis = Remove-GPLink [-Name] <String> | -Guid <Guid> [-Target] <String>
    .option-Name = the GPO by its name.
    .option-Guid = the GPO by its id.
    .option-Target = the domain or the OU (a DN).
    .example-1 = unlink
man-Get-GPInheritance = shows what reaches a container: its own links (GpoLinks), whether it blocks inheritance, and every GPO that applies, highest precedence first (InheritedGpoLinks).

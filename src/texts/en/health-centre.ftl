### What the chapters of "The Health Centre" share: the game's own messages
### about the virtualisation commands (virsh, qemu-img). Commands, options,
### paths and outputs are not translated.

virsh-edit-dropped = (In the game, virsh edit doesn't offer to try again: your change was not applied. Run virsh edit again.)
virsh-console-left = (The game leaves the console here, as if you had pressed Ctrl-]: the guest's console isn't interactive in the game. Use ssh to log in.)
virsh-only-system = the game's virsh only talks to qemu:///system, not to { $uri }
virsh-no-shell = virsh: the interactive virsh shell is not simulated in this game: give it a command (virsh list --all, virsh help).
virsh-help-man = The game's virsh manual: man virsh.

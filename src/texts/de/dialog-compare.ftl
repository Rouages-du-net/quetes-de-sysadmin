### The comparison with the previous runs of a chapter, in the summary's
### dialog (src/engine/runs.ts), loaded when it first opens
### (src/texts/plugin.mjs: dialog-*.ftl). The "Replay this chapter" button
### and the summary's line are in interface.ftl.

compare-title = Im Vergleich zu deinen vorherigen Durchgängen
compare-intro = Deine letzten Durchgänge dieses Kapitels, nur in diesem Browser gespeichert. Weniger Befehle sind kein Ziel an sich: das Handbuch lesen, sich umsehen und die eigene Arbeit prüfen gehören zum Beruf.
compare-caption = Deine Durchgänge dieses Kapitels
compare-col-measure = Messwert
# { $date }: the day of an earlier run, spelled out
compare-col-run = Durchgang vom { $date }
compare-col-this = Dieser Durchgang
compare-exam = (Prüfungsmodus)
compare-commands = Getippte Befehle
compare-distinct = Verschiedene Befehle
compare-errors = Fehlgeschlagene Befehle
compare-hints = Angeforderte Hinweise
compare-time = Benötigte Zeit
compare-not-measured = nicht gemessen
# After this run's value, compared with the run just before it.
compare-better = weniger als letztes Mal
compare-worse = mehr als letztes Mal
compare-same = wie letztes Mal
compare-diff-title = Deine Befehle neben denen vom letzten Mal
compare-diff-intro = Der Reihe nach: − nur letztes Mal, + nur dieses Mal, die anderen in beiden Durchgängen. Die Referenzlösung, Schritt für Schritt, steht in der Tabelle oben.
compare-only-before = Nur letztes Mal:
compare-only-after = Nur dieses Mal:
compare-both = Beide Male:
compare-diff-empty = In keinem der beiden Durchgänge wurde ein Befehl getippt.

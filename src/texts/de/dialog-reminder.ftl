### The daily reminder's dialog (src/engine/reminder.ts), loaded when it
### first opens (src/texts/plugin.mjs: dialog-*.ftl). Its button is in
### interface.ftl.

reminder-title = Eine tägliche Erinnerung in deinem Kalender
reminder-intro = Wähle eine Uhrzeit: Das Spiel erstellt eine Kalenderdatei (.ics) mit einem Termin jeden Tag zu dieser Uhrzeit und einer Benachrichtigung. Öffne die Datei mit deiner Kalender-App, auf dem Handy oder dem Computer, um sie hinzuzufügen.
reminder-time = Uhrzeit der Erinnerung
reminder-download = Kalenderdatei herunterladen
reminder-floating = Die Uhrzeit bleibt gleich, wo du auch bist, und auch bei der Zeitumstellung.
reminder-private = Nichts wird irgendwohin gesendet: Die Datei entsteht in deinem Browser, und nur deine Kalender-App behält sie. Um die Erinnerungen zu beenden, lösche den Termin aus deinem Kalender.
reminder-ready = Datei heruntergeladen: Öffne sie, um die Erinnerung zu deinem Kalender hinzuzufügen.
reminder-invalid = Wähle eine Uhrzeit, zum Beispiel 18:30.
reminder-close = Schließen
# The downloaded file's name.
reminder-file = sysadmin-quests-erinnerung.ics
# The event in the player's calendar. { $url }: the game's address.
reminder-event-title = Sysadmin-Quests: der Vorfall des Tages
reminder-event-description = Ein paar Minuten Bereitschaft: Der Vorfall von heute wartet auf dich. { $url }
reminder-event-alarm = Zeit für den Vorfall von heute

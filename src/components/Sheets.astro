---
// Les fiches pour les enseignant·es, dans une langue : une par chapitre
// (objectif, ce qu'il faut avoir fait avant, commandes découvertes, durée
// indicative), tirées des histoires elles-mêmes à la construction du site.
// Les textes des histoires viennent de src/texts/<langue>/ ; ceux de la page,
// d'ici (une page par langue, comme le reste du site).
import { STORIES } from '../engine/chapters';
import { allSheets } from '../engine/sheets';
import { difficulty, stars } from '../engine/difficulty';
import { translator, typography } from '../texts';

interface Props {
  lang: 'fr' | 'en';
}
const { lang } = Astro.props;
const t = translator(lang);
const typo = (text: string) => typography(text, lang);
const sheets = allSheets();
const total = sheets.reduce((s, f) => s + f.duration, 0);
const hours = (minutes: number) =>
  lang === 'en'
    ? minutes < 60
      ? `${minutes} min`
      : `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${String(minutes % 60).padStart(2, '0')} min` : ''}`
    : minutes < 60
      ? `${minutes} min`
      : `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${String(minutes % 60).padStart(2, '0')}` : ''}`;
const fr = lang === 'fr';
// Les chapitres à finir avant d'ouvrir une histoire, avec le titre de leur histoire.
const storyOf = (c: string) => STORIES.find((h) => h.chapters.some((x) => x.id === c))!;
const after = (ids: string[]) =>
  new Intl.ListFormat(lang, { type: 'conjunction' }).format(
    ids.map((c) => (fr ? `« ${t(`chapter-${c}`)} » (${t(`story-${storyOf(c).id}`)})` : `"${t(`chapter-${c}`)}" (${t(`story-${storyOf(c).id}`)})`)),
  );
---
<h1>{fr ? 'Pour les enseignant·es' : 'For teachers'}</h1>
{fr ? (
  <p class="intro">
    Chaque chapitre est une petite mission sur un serveur simulé, avec de vraies commandes. Le jeu
    vérifie le <strong>résultat</strong> sur l'état du système, pas la commande exacte : plusieurs
    solutions correctes passent, et chaque chapitre se termine par un débrief (ce qui s'est passé,
    la bonne pratique, la documentation officielle).
  </p>
) : (
  <p class="intro">
    Each chapter is a small mission on a simulated server, with real commands. The game checks the
    <strong>result</strong> on the state of the system, not the exact command: several correct
    solutions pass, and each chapter ends with a debrief (what happened, the good practice, the
    official documentation).
  </p>
)}
<p class="intro">
  {fr
    ? `${STORIES.length} histoires, ${sheets.length} chapitres, environ ${hours(total)} en tout. Les durées sont indicatives (une dizaine de minutes pour s'installer, puis quelques minutes par étape vérifiée) : un groupe débutant prendra plus de temps. La difficulté, de 1 à 5, dit surtout ce que le chapitre suppose déjà vu dans le jeu, un peu sa taille.`
    : `${STORIES.length} stories, ${sheets.length} chapters, about ${hours(total)} in all. Durations are only a guide (ten minutes or so to settle in, then a few minutes per checked step): a beginner group will take longer. Difficulty, from 1 to 5, mostly says how much of the game the chapter takes for granted, and a little how big it is.`}
</p>

<section aria-labelledby="organiser">
  <h2 id="organiser">{fr ? 'Organiser une séance' : 'Running a session'}</h2>
  {fr ? (
    <ul class="intro">
      <li><strong>Sans compte, sans installation</strong> : la progression reste dans le navigateur de chaque élève. Rien n'est envoyé nulle part.</li>
      <li><strong>L'Effaceur d'abord</strong> : il apprend à se déplacer et donne les clés SSH des autres histoires. Pour ouvrir directement une autre histoire (un TP ciblé), intégrez le jeu avec son attribut <code>story</code> (voir chaque histoire ci-dessous).</li>
      <li><strong>Rendre son travail</strong> : sous le terminal, le « carnet du sysadmin » se télécharge en Markdown. Il contient la progression (chapitres terminés) et les commandes utilisées, avec la première ligne tapée.</li>
      <li><strong>Changer de machine</strong> : « Ma progression », sous le terminal, donne un code court à recopier (les chapitres terminés) ou un fichier qui emporte tout (carnet compris), et un nom facultatif qui s'inscrit en tête du carnet. Ni l'un ni l'autre n'est une preuve : un code se recopie, un fichier se modifie.</li>
      <li><strong>Suivre la classe</strong> : le <a href="/fr/enseignants/classe/">tableau de classe</a> lit les fichiers ou les codes de tes élèves, dans ton navigateur, et les exporte en CSV.</li>
      <li><strong>En évaluation</strong> : le mode examen recommence un chapitre sans aucun indice, avec un chrono.</li>
      <li><strong>Bloqué·e ?</strong> Le jeu renvoie vers <code>man</code>, <code>--help</code> et <code>man -k</code> plutôt que de donner la réponse : c'est le réflexe à faire prendre.</li>
    </ul>
  ) : (
    <ul class="intro">
      <li><strong>No account, nothing to install</strong>: progress stays in each student's browser. Nothing is sent anywhere.</li>
      <li><strong>The Eraser first</strong>: it teaches how to move around and gives the SSH keys to the other stories. To open another story directly (a focused lab), embed the game with its <code>story</code> attribute (see each story below), and <code>lang="en"</code>.</li>
      <li><strong>Handing in work</strong>: under the terminal, the "sysadmin notebook" downloads as Markdown. It contains the progress (finished chapters) and the commands used, with the first line typed.</li>
      <li><strong>Changing machines</strong>: "My progress", under the terminal, gives a short code to copy down (the finished chapters) or a file that takes everything (notebook included), and an optional name that goes at the top of the notebook. Neither is proof: a code can be copied, a file can be edited.</li>
      <li><strong>Following the class</strong>: the <a href="/en/teachers/class/">class table</a> reads your students' files or codes, in your browser, and exports them as CSV.</li>
      <li><strong>For assessment</strong>: exam mode restarts a chapter with no hints at all, and a timer.</li>
      <li><strong>Stuck?</strong> The game points to <code>man</code>, <code>--help</code> and <code>man -k</code> rather than giving the answer: that is the habit to build.</li>
    </ul>
  )}
</section>

{STORIES.map((h) => {
  const list = sheets.filter((f) => f.story === h);
  const duration = hours(list.reduce((s, f) => s + f.duration, 0));
  return (
    <section class="fiche-histoire" aria-labelledby={`h-${h.id}`}>
      <h2 id={`h-${h.id}`}>{t(`story-${h.id}`)}</h2>
      <p>{typo(t(`story-${h.id}.summary`))}</p>
      <p class="discret">
        {fr
          ? `${list.length} ${list.length > 1 ? 'chapitres' : 'chapitre'}, environ ${duration}.`
          : `${list.length} ${list.length > 1 ? 'chapters' : 'chapter'}, about ${duration}.`}
        {h.after && (fr ? ` S'ouvre dans le jeu après ${after(h.after)}, sauf en ouverture directe :` : ` Opens in the game after ${after(h.after)}, unless opened directly:`)}
      </p>
      {h.id !== 'eraser' && <pre><code>{`<quetes-de-sysadmin story="${h.id}"${fr ? ' lang="fr"' : ' lang="en"'}></quetes-de-sysadmin>`}</code></pre>}
      <ol class="fiches">
        {list.map((f) => (
          <li class="fiche" id={`c-${f.chapter.id}`}>
            <h3>{t('chapter-number', { number: f.chapter.number })}{fr ? ' : ' : ': '}{t(`chapter-${f.chapter.id}`)}</h3>
            <dl>
              <dt>{fr ? 'Objectif' : 'Goal'}</dt>
              <dd>{typo(t(`chapter-${f.chapter.id}.summary`))}</dd>
              <dt>{fr ? 'Avant' : 'Before'}</dt>
              <dd>
                {f.before
                  ? fr ? `« ${t(`chapter-${f.before.id}`)} »` : `"${t(`chapter-${f.before.id}`)}"`
                  : h.id === 'eraser'
                    ? fr ? 'Rien : on part de zéro.' : 'Nothing: you start from scratch.'
                    : fr ? `${after(h.after ?? [])} (ou une ouverture directe).` : `${after(h.after ?? [])} (or a live opening).`}
              </dd>
              <dt>{fr ? 'Commandes découvertes' : 'New commands'}</dt>
              <dd>
                {f.fresh.length
                  ? f.fresh.map((c, i) => <>{i > 0 && ', '}<code>{c}</code></>)
                  : fr ? "Aucune nouvelle : on réutilise ce qu'on connaît." : 'None: you reuse what you know.'}
              </dd>
              <dt>{fr ? 'Difficulté' : 'Difficulty'}</dt>
              <dd><span aria-hidden="true">{stars(difficulty(f.chapter.id))}</span> {fr ? `${difficulty(f.chapter.id)} sur 5` : `${difficulty(f.chapter.id)} out of 5`}</dd>
              <dt>{fr ? 'Durée indicative' : 'Approximate time'}</dt>
              <dd>{hours(f.duration)}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </section>
  );
})}
"
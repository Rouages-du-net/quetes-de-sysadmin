---
// The teachers' sheets, in one language: one per chapter
// (objective, what must have been done before, new commands, approximate
// time), drawn from the stories themselves when the site is built.
// The stories' texts come from src/texts/<language>/; the page's own,
// from here (one page per language, like the rest of the site).
import { STORIES } from '../engine/chapters';
import { allSheets, hours as duration } from '../engine/sheets';
import { difficulty, stars } from '../engine/difficulty';
import { loadAllTexts, translator, typography } from '../texts';
import { PAGES } from '../site-languages';

interface Props {
  lang: 'fr' | 'en' | 'es' | 'de';
}
const { lang } = Astro.props;
await loadAllTexts();
const t = translator(lang);
const typo = (text: string) => typography(text, lang);
const sheets = allSheets();
const total = sheets.reduce((s, f) => s + f.duration, 0);
const hours = (minutes: number) => duration(minutes, lang);
// The chapters to finish before a story opens, with the title of their story.
const storyOf = (c: string) => STORIES.find((h) => h.chapters.some((x) => x.id === c))!;
const QUOTES = { en: ['"', '"'], fr: ['« ', ' »'], es: ['«', '»'], de: ['„', '“'] }[lang];
const quoted = (text: string) => `${QUOTES[0]}${text}${QUOTES[1]}`;
const after = (ids: string[]) =>
  new Intl.ListFormat(lang, { type: 'conjunction' }).format(ids.map((c) => `${quoted(t(`chapter-${c}`))} (${t(`story-${storyOf(c).id}`)})`));
const plural = (n: number, one: string, other: string) => (n > 1 ? other : one);

// The page's own texts, in each language.
const TEXTS = {
  en: {
    title: 'For teachers',
    intro: 'Each chapter is a small mission on a simulated server, with real commands. The game checks the <strong>result</strong> on the state of the system, not the exact command: several correct solutions pass, and each chapter ends with a debrief (what happened, the good practice, the official documentation).',
    total: (stories: number, chapters: number, time: string) =>
      `${stories} stories, ${chapters} chapters, about ${time} in all. Durations are only a guide (ten minutes or so to settle in, then a few minutes per checked step): a beginner group will take longer. Difficulty, from 1 to 5, mostly says how much of the game the chapter takes for granted, and a little how big it is.`,
    organise: 'Running a session',
    tips: [
      '<strong>No account, nothing to install</strong>: progress stays in each student\'s browser. Nothing is sent anywhere.',
      '<strong>The Eraser first</strong>: it teaches how to move around and gives the SSH keys to the other stories. To open another story directly (a focused lab), embed the game with its <code>story</code> attribute (see each story below), and <code>lang="en"</code>.',
      '<strong>Handing in work</strong>: under the terminal, the "sysadmin notebook" downloads as Markdown. It contains the progress (finished chapters) and the commands used, with the first line typed.',
      '<strong>Changing machines</strong>: "My progress", under the terminal, gives a short code to copy down (the finished chapters) or a file that takes everything (notebook included), and an optional name that goes at the top of the notebook. Neither is proof: a code can be copied, a file can be edited.',
      `<strong>Following the class</strong>: the <a href="${PAGES.classTable.en}">class table</a> reads your students' files or codes, in your browser, and exports them as CSV (for a spreadsheet) or prints them.`,
      '<strong>Printing</strong>: each story has a <strong>handout</strong> (link under its title): goals, commands, the manual pages to read, questions to check what was learnt, and, folded, a teacher\'s version with the solution route. The "Print" button below prints every sheet of this page, one story per page.',
      '<strong>For assessment</strong>: exam mode restarts a chapter with no hints at all, and a timer.',
      '<strong>Stuck?</strong> The game points to <code>man</code>, <code>--help</code> and <code>man -k</code> rather than giving the answer: that is the habit to build.',
    ],
    print: 'Print the sheets',
    handout: (story: string) => `Printable sheet: ${story}`,
    chapters: (n: number, time: string) => `${n} ${plural(n, 'chapter', 'chapters')}, about ${time}.`,
    opensAfter: (list: string) => ` Opens in the game after ${list}, unless opened directly:`,
    colon: ': ',
    goal: 'Goal',
    before: 'Before',
    scratch: 'Nothing: you start from scratch.',
    orLive: (list: string) => `${list} (or a live opening).`,
    fresh: 'New commands',
    none: 'None: you reuse what you know.',
    difficulty: 'Difficulty',
    outOf: (n: number) => `${n} out of 5`,
    time: 'Approximate time',
  },
  fr: {
    title: 'Pour les enseignant·es',
    intro: "Chaque chapitre est une petite mission sur un serveur simulé, avec de vraies commandes. Le jeu vérifie le <strong>résultat</strong> sur l'état du système, pas la commande exacte : plusieurs solutions correctes passent, et chaque chapitre se termine par un débrief (ce qui s'est passé, la bonne pratique, la documentation officielle).",
    total: (stories: number, chapters: number, time: string) =>
      `${stories} histoires, ${chapters} chapitres, environ ${time} en tout. Les durées sont indicatives (une dizaine de minutes pour s'installer, puis quelques minutes par étape vérifiée) : un groupe débutant prendra plus de temps. La difficulté, de 1 à 5, dit surtout ce que le chapitre suppose déjà vu dans le jeu, un peu sa taille.`,
    organise: 'Organiser une séance',
    tips: [
      "<strong>Sans compte, sans installation</strong> : la progression reste dans le navigateur de chaque élève. Rien n'est envoyé nulle part.",
      "<strong>L'Effaceur d'abord</strong> : il apprend à se déplacer et donne les clés SSH des autres histoires. Pour ouvrir directement une autre histoire (un TP ciblé), intégrez le jeu avec son attribut <code>story</code> (voir chaque histoire ci-dessous).",
      '<strong>Rendre son travail</strong> : sous le terminal, le « carnet du sysadmin » se télécharge en Markdown. Il contient la progression (chapitres terminés) et les commandes utilisées, avec la première ligne tapée.',
      "<strong>Changer de machine</strong> : « Ma progression », sous le terminal, donne un code court à recopier (les chapitres terminés) ou un fichier qui emporte tout (carnet compris), et un nom facultatif qui s'inscrit en tête du carnet. Ni l'un ni l'autre n'est une preuve : un code se recopie, un fichier se modifie.",
      `<strong>Suivre la classe</strong> : le <a href="${PAGES.classTable.fr}">tableau de classe</a> lit les fichiers ou les codes de tes élèves, dans ton navigateur, les exporte en CSV (pour un tableur) ou les imprime.`,
      "<strong>Imprimer</strong> : chaque histoire a sa <strong>fiche à distribuer</strong> (lien sous son titre) : objectifs, commandes, pages du manuel à lire, questions pour vérifier ce qu'on a appris, et, repliée, une version enseignant·e avec le chemin de solution. Le bouton « Imprimer » ci-dessous imprime toutes les fiches de cette page, une histoire par page.",
      '<strong>En évaluation</strong> : le mode examen recommence un chapitre sans aucun indice, avec un chrono.',
      "<strong>Bloqué·e ?</strong> Le jeu renvoie vers <code>man</code>, <code>--help</code> et <code>man -k</code> plutôt que de donner la réponse : c'est le réflexe à faire prendre.",
    ],
    print: 'Imprimer les fiches',
    handout: (story: string) => `Fiche à imprimer : ${story}`,
    chapters: (n: number, time: string) => `${n} ${plural(n, 'chapitre', 'chapitres')}, environ ${time}.`,
    opensAfter: (list: string) => ` S'ouvre dans le jeu après ${list}, sauf en ouverture directe :`,
    colon: ' : ',
    goal: 'Objectif',
    before: 'Avant',
    scratch: 'Rien : on part de zéro.',
    orLive: (list: string) => `${list} (ou une ouverture directe).`,
    fresh: 'Commandes découvertes',
    none: "Aucune nouvelle : on réutilise ce qu'on connaît.",
    difficulty: 'Difficulté',
    outOf: (n: number) => `${n} sur 5`,
    time: 'Durée indicative',
  },
  es: {
    title: 'Para docentes',
    intro: 'Cada capítulo es una pequeña misión en un servidor simulado, con comandos reales. El juego comprueba el <strong>resultado</strong> en el estado del sistema, no el comando exacto: pasan varias soluciones correctas, y cada capítulo termina con un repaso (qué pasó, la buena práctica, la documentación oficial).',
    total: (stories: number, chapters: number, time: string) =>
      `${stories} historias, ${chapters} capítulos, unas ${time} en total. Las duraciones son orientativas (unos diez minutos para instalarse y luego unos minutos por cada paso comprobado): un grupo principiante tardará más. La dificultad, de 1 a 5, dice sobre todo cuánto del juego da por visto el capítulo, y un poco su tamaño.`,
    organise: 'Organizar una sesión',
    tips: [
      '<strong>Sin cuenta, sin instalación</strong>: el progreso se queda en el navegador de cada estudiante. No se envía nada a ninguna parte.',
      '<strong>Primero El Borrador</strong>: enseña a moverse y da las claves SSH de las demás historias. Para abrir directamente otra historia (una práctica concreta), integra el juego con su atributo <code>story</code> (mira cada historia más abajo) y <code>lang="es"</code>. La traducción al español está en curso: las historias aún sin traducir se juegan en inglés.',
      '<strong>Entregar el trabajo</strong>: debajo de la terminal, el «cuaderno del sysadmin» se descarga en Markdown. Contiene el progreso (capítulos terminados) y los comandos usados, con la primera línea escrita.',
      '<strong>Cambiar de equipo</strong>: «Mi progreso», debajo de la terminal, da un código corto para copiar (los capítulos terminados) o un archivo que se lo lleva todo (cuaderno incluido), y un nombre opcional que aparece al principio del cuaderno. Ninguno de los dos es una prueba: un código se puede copiar y un archivo se puede modificar.',
      `<strong>Seguir a la clase</strong>: la <a href="${PAGES.classTable.es}">tabla de la clase</a> lee los archivos o los códigos de tu alumnado, en tu navegador, y los exporta en CSV (para una hoja de cálculo) o los imprime.`,
      '<strong>Imprimir</strong>: cada historia tiene su <strong>ficha para repartir</strong> (enlace bajo su título): objetivos, comandos, páginas del manual que leer, preguntas para comprobar lo aprendido y, plegada, una versión para docentes con el camino de la solución. El botón «Imprimir» de abajo imprime todas las fichas de esta página, una historia por página.',
      '<strong>Para evaluar</strong>: el modo examen vuelve a empezar un capítulo sin ninguna pista y con cronómetro.',
      '<strong>¿Hay bloqueo?</strong> El juego remite a <code>man</code>, <code>--help</code> y <code>man -k</code> en lugar de dar la respuesta: ese es el hábito que hay que crear.',
    ],
    print: 'Imprimir las fichas',
    handout: (story: string) => `Ficha para imprimir: ${story}`,
    chapters: (n: number, time: string) => `${n} ${plural(n, 'capítulo', 'capítulos')}, unos ${time}.`,
    opensAfter: (list: string) => ` Se abre en el juego después de ${list}, salvo si se abre directamente:`,
    colon: ': ',
    goal: 'Objetivo',
    before: 'Antes',
    scratch: 'Nada: se empieza desde cero.',
    orLive: (list: string) => `${list} (o una apertura directa).`,
    fresh: 'Comandos nuevos',
    none: 'Ninguno nuevo: se reutiliza lo que ya se conoce.',
    difficulty: 'Dificultad',
    outOf: (n: number) => `${n} de 5`,
    time: 'Duración aproximada',
  },
  de: {
    title: 'Für Lehrkräfte',
    intro: 'Jedes Kapitel ist eine kleine Mission auf einem simulierten Server, mit echten Befehlen. Das Spiel prüft das <strong>Ergebnis</strong> am Zustand des Systems, nicht den genauen Befehl: Mehrere richtige Lösungen werden akzeptiert, und jedes Kapitel endet mit einer Nachbesprechung (was passiert ist, die gute Praxis, die offizielle Dokumentation).',
    total: (stories: number, chapters: number, time: string) =>
      `${stories} Geschichten, ${chapters} Kapitel, insgesamt etwa ${time}. Die Zeiten sind Richtwerte (etwa zehn Minuten zum Einfinden, dann einige Minuten pro geprüftem Schritt): Eine Gruppe von Anfänger·innen braucht länger. Die Schwierigkeit von 1 bis 5 sagt vor allem, wie viel vom Spiel das Kapitel voraussetzt, und ein wenig, wie umfangreich es ist.`,
    organise: 'Eine Unterrichtsstunde gestalten',
    tips: [
      '<strong>Ohne Konto, ohne Installation</strong>: Der Fortschritt bleibt im Browser jeder Person. Nichts wird irgendwohin gesendet.',
      '<strong>Zuerst der Radierer</strong>: Er bringt bei, sich zu bewegen, und gibt die SSH-Schlüssel für die anderen Geschichten. Um eine andere Geschichte direkt zu öffnen (eine gezielte Übung), bette das Spiel mit seinem Attribut <code>story</code> (siehe jede Geschichte unten) und <code>lang="de"</code> ein. Die deutsche Übersetzung ist in Arbeit: Noch nicht übersetzte Geschichten werden auf Englisch gespielt.',
      '<strong>Die Arbeit abgeben</strong>: Unter dem Terminal lässt sich das „Sysadmin-Notizbuch“ als Markdown herunterladen. Es enthält den Fortschritt (abgeschlossene Kapitel) und die verwendeten Befehle, mit der ersten getippten Zeile.',
      '<strong>Den Rechner wechseln</strong>: „Mein Fortschritt“ unter dem Terminal gibt einen kurzen Code zum Abschreiben (die abgeschlossenen Kapitel) oder eine Datei, die alles mitnimmt (samt Notizbuch), und einen optionalen Namen, der oben im Notizbuch steht. Beides ist kein Beweis: Ein Code lässt sich abschreiben, eine Datei bearbeiten.',
      `<strong>Die Klasse begleiten</strong>: Die <a href="${PAGES.classTable.de}">Klassenübersicht</a> liest die Dateien oder Codes deiner Schüler·innen in deinem Browser, exportiert sie als CSV (für eine Tabellenkalkulation) oder druckt sie.`,
      '<strong>Drucken</strong>: Jede Geschichte hat ihr <strong>Arbeitsblatt zum Austeilen</strong> (Link unter ihrem Titel): Ziele, Befehle, die zu lesenden Handbuchseiten, Fragen zur Lernkontrolle und, eingeklappt, eine Fassung für Lehrkräfte mit dem Lösungsweg. Die Schaltfläche „Drucken“ unten druckt alle Blätter dieser Seite, eine Geschichte pro Seite.',
      '<strong>Zur Bewertung</strong>: Der Prüfungsmodus beginnt ein Kapitel ohne jeden Hinweis neu, mit Stoppuhr.',
      '<strong>Festgefahren?</strong> Das Spiel verweist auf <code>man</code>, <code>--help</code> und <code>man -k</code>, statt die Antwort zu geben: Genau diese Gewohnheit soll entstehen.',
    ],
    print: 'Die Blätter drucken',
    handout: (story: string) => `Arbeitsblatt zum Ausdrucken: ${story}`,
    chapters: (n: number, time: string) => `${n} ${plural(n, 'Kapitel', 'Kapitel')}, etwa ${time}.`,
    opensAfter: (list: string) => ` Öffnet sich im Spiel nach ${list}, außer bei direktem Öffnen:`,
    colon: ': ',
    goal: 'Ziel',
    before: 'Vorher',
    scratch: 'Nichts: Man fängt bei null an.',
    orLive: (list: string) => `${list} (oder direktes Öffnen).`,
    fresh: 'Neue Befehle',
    none: 'Keine neuen: Man nutzt, was man schon kennt.',
    difficulty: 'Schwierigkeit',
    outOf: (n: number) => `${n} von 5`,
    time: 'Ungefähre Dauer',
  },
};
const T = TEXTS[lang];
---
<h1>{T.title}</h1>
<p class="intro" set:html={T.intro} />
<p class="intro">{T.total(STORIES.length, sheets.length, hours(total))}</p>

<section aria-labelledby="organiser">
  <h2 id="organiser">{T.organise}</h2>
  <ul class="intro">
    {T.tips.map((tip) => <li set:html={tip} />)}
  </ul>
  <p class="print-actions" hidden><button type="button" class="print-button" data-print>{T.print}</button></p>
</section>

{STORIES.map((h) => {
  const list = sheets.filter((f) => f.story === h);
  const duration = hours(list.reduce((s, f) => s + f.duration, 0));
  return (
    <section class="sheet-story" aria-labelledby={`h-${h.id}`}>
      <h2 id={`h-${h.id}`}>{t(`story-${h.id}`)}</h2>
      <p class="story-handout"><a href={PAGES.sheet(h.id)[lang]}>{T.handout(t(`story-${h.id}`))}</a></p>
      <p>{typo(t(`story-${h.id}.summary`))}</p>
      <p class="muted">
        {T.chapters(list.length, duration)}
        {h.after && T.opensAfter(after(h.after))}
      </p>
      {h.id !== 'eraser' && <pre tabindex="0"><code>{`<quetes-de-sysadmin story="${h.id}" lang="${lang}"></quetes-de-sysadmin>`}</code></pre>}
      <ol class="sheets">
        {list.map((f) => (
          <li class="sheet" id={`c-${f.chapter.id}`}>
            <h3>{t('chapter-number', { number: f.chapter.number })}{T.colon}{t(`chapter-${f.chapter.id}`)}</h3>
            <dl>
              <dt>{T.goal}</dt>
              <dd>{typo(t(`chapter-${f.chapter.id}.summary`))}</dd>
              <dt>{T.before}</dt>
              <dd>
                {f.before
                  ? quoted(t(`chapter-${f.before.id}`))
                  : h.id === 'eraser'
                    ? T.scratch
                    : T.orLive(after(h.after ?? []))}
              </dd>
              <dt>{T.fresh}</dt>
              <dd>
                {f.fresh.length
                  ? f.fresh.map((c, i) => <>{i > 0 && ', '}<code>{c}</code></>)
                  : T.none}
              </dd>
              <dt>{T.difficulty}</dt>
              <dd><span aria-hidden="true">{stars(difficulty(f.chapter.id))}</span> {T.outOf(difficulty(f.chapter.id))}</dd>
              <dt>{T.time}</dt>
              <dd>{hours(f.duration)}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </section>
  );
})}
<script>
  import '../interface/print';
</script>

---
// A story's printable sheet, in one language: a handout for the students
// (each chapter's goal, what comes before, difficulty, time, new commands,
// the manual pages to read, the documentation its debrief points to, and
// questions to check what was learnt, without the answers), then, folded,
// the teacher's version: the solution route, the same steps and hints the
// game gives a player who asks for the third hint. A closed <details> is
// not printed: the handout prints alone unless the teacher opens it.
// Drawn from the stories when the site is built; the page's own texts are
// here, one page per language, like the quest sheets (Sheets.astro).
import { STORIES } from '../engine/chapters';
import { storySheets, manualPages, documentation, solutionRoute, hours } from '../engine/sheets';
import { difficulty, stars } from '../engine/difficulty';
import { loadAllTexts, translator, typography } from '../texts';

interface Props {
  lang: 'fr' | 'en';
  story: string;
}
const { lang, story } = Astro.props;
await loadAllTexts();
const t = translator(lang);
const typo = (text: string) => typography(text, lang);
const fr = lang === 'fr';
const h = STORIES.find((x) => x.id === story)!;
const sheets = storySheets(story);
const total = hours(sheets.reduce((s, f) => s + f.duration, 0), lang);
const storyOf = (c: string) => STORIES.find((x) => x.chapters.some((y) => y.id === c))!;
const quoted = (c: string) => (fr ? `« ${t(`chapter-${c}`)} »` : `"${t(`chapter-${c}`)}"`);
const after = (ids: string[]) =>
  new Intl.ListFormat(lang, { type: 'conjunction' }).format(ids.map((c) => `${quoted(c)} (${t(`story-${storyOf(c).id}`)})`));
const title = (n: number, id: string) => `${t('chapter-number', { number: n })}${fr ? ' : ' : ': '}${t(`chapter-${id}`)}`;
const teachers = fr ? '/fr/enseignants/' : '/en/teachers/';
// Questions to check what was learnt: open questions, the same for every
// chapter, then one per command it introduces (three at most). They ask
// the student to explain; the answers are the student's own.
const QUESTIONS = 3;
---
<p class="crumbs no-print"><a href={teachers}>{fr ? 'Pour les enseignant·es' : 'For teachers'}</a> › {fr ? 'Fiche à imprimer' : 'Printable sheet'}</p>
<h1>{t(`story-${h.id}`)}</h1>
<div class="no-print sheet-help">
  {fr ? (
    <p class="intro">
      Une fiche à distribuer : les objectifs de chaque chapitre, sans les solutions, les commandes et
      les pages du manuel à lire, et des questions pour vérifier ce qu'on a appris. Elle s'imprime sur
      A4 comme sur Letter, en noir et blanc, les liens écrits en entier. La version enseignant·e, en
      bas de page, ne s'imprime que si tu l'ouvres.
    </p>
  ) : (
    <p class="intro">
      A handout: each chapter's goal, without the solutions, the commands and manual pages to read,
      and questions to check what was learnt. It prints on A4 or Letter, in black and white, with
      the links written out. The teacher's version, at the bottom of the page, prints only if you
      open it.
    </p>
  )}
  <p class="print-actions" hidden><button type="button" class="print-button" data-print>{fr ? 'Imprimer la fiche' : 'Print the sheet'}</button></p>
</div>

<p class="print-only handout-name">{fr ? 'Nom : ______________________   Classe : __________   Date : __________' : 'Name: ______________________   Class: __________   Date: __________'}</p>
<p class="intro">{typo(t(`story-${h.id}.summary`))}</p>
<p class="muted">
  {fr
    ? `${sheets.length} ${sheets.length > 1 ? 'chapitres' : 'chapitre'}, environ ${total}.`
    : `${sheets.length} ${sheets.length > 1 ? 'chapters' : 'chapter'}, about ${total}.`}
  {h.after
    ? fr
      ? ` S'ouvre dans le jeu après ${after(h.after)}.`
      : ` Opens in the game after ${after(h.after)}.`
    : fr
      ? " La première histoire : on part de zéro."
      : ' The first story: you start from scratch.'}
  {' '}
  {fr ? 'Le jeu : ' : 'The game: '}<a href={fr ? '/fr/' : '/en/'}>{fr ? 'Quêtes de Sysadmin' : 'Sysadmin Quests'}</a>.
</p>

<section aria-labelledby="chapters">
  <h2 id="chapters">{fr ? 'Les chapitres' : 'The chapters'}</h2>
  <ol class="sheets">
    {sheets.map((f) => {
      const pages = manualPages(f, t);
      const docs = documentation(f.chapter, t);
      return (
        <li class="sheet" id={`c-${f.chapter.id}`}>
          <h3>{title(f.chapter.number, f.chapter.id)}</h3>
          <dl>
            <dt>{fr ? 'Objectif' : 'Goal'}</dt>
            <dd>{typo(t(`chapter-${f.chapter.id}.summary`))}</dd>
            <dt>{fr ? 'Avant' : 'Before'}</dt>
            <dd>
              {f.before
                ? quoted(f.before.id)
                : h.after
                  ? `${after(h.after)}${fr ? ' (ou une ouverture directe).' : ' (or a direct opening).'}`
                  : fr ? 'Rien : on part de zéro.' : 'Nothing: you start from scratch.'}
            </dd>
            <dt>{fr ? 'Difficulté' : 'Difficulty'}</dt>
            <dd><span aria-hidden="true">{stars(difficulty(f.chapter.id))}</span> {fr ? `${difficulty(f.chapter.id)} sur 5` : `${difficulty(f.chapter.id)} out of 5`}</dd>
            <dt>{fr ? 'Durée indicative' : 'Approximate time'}</dt>
            <dd>{hours(f.duration, lang)}</dd>
            <dt>{fr ? 'Commandes découvertes' : 'New commands'}</dt>
            <dd>
              {f.fresh.length
                ? f.fresh.map((c, i) => <>{i > 0 && ', '}<code>{c}</code></>)
                : fr ? "Aucune nouvelle : on réutilise ce qu'on connaît." : 'None: you reuse what you know.'}
            </dd>
            {pages.length > 0 && (
              <>
                <dt>{fr ? 'À lire dans le manuel' : 'Read in the manual'}</dt>
                <dd>
                  <ul class="manual-pages">
                    {pages.map((p) => <li><code>man {p.name}</code>{fr ? ' : ' : ': '}{p.whatis}</li>)}
                  </ul>
                </dd>
              </>
            )}
            {docs.length > 0 && (
              <>
                <dt>{fr ? 'Pour aller plus loin' : 'Further reading'}</dt>
                <dd>
                  <ul class="documentation">
                    {docs.map((d) => <li><a href={d.url}>{d.label}</a></li>)}
                  </ul>
                </dd>
              </>
            )}
          </dl>
        </li>
      );
    })}
  </ol>
</section>

<section aria-labelledby="questions" class="questions">
  <h2 id="questions">{fr ? 'Vérifier ce que tu as appris' : 'Check what you learnt'}</h2>
  <p class="intro muted">
    {fr
      ? "À faire après chaque chapitre, sans le jeu sous les yeux. Le manuel (man) est permis : c'est le bon réflexe."
      : 'After each chapter, without the game in front of you. The manual (man) is allowed: that is the right habit.'}
  </p>
  {sheets.map((f) => (
    <div class="question-block">
      <h3>{title(f.chapter.number, f.chapter.id)}</h3>
      <ol>
        <li>{fr ? "Qu'est-ce qui n'allait pas au début du chapitre, et comment as-tu vérifié que c'était réparé ?" : 'What was wrong at the start of the chapter, and how did you check that it was fixed?'}</li>
        {f.fresh.slice(0, QUESTIONS).map((c) => (
          <li>{fr ? <>À quoi t'a servi <code>{c}</code> ? Cite une de ses options et ce qu'elle fait (<code>man {c}</code>).</> : <>What did you use <code>{c}</code> for? Name one of its options and what it does (<code>man {c}</code>).</>}</li>
        ))}
        <li>{fr ? 'Quelle bonne pratique du débrief appliquerais-tu sur un vrai serveur, et pourquoi ?' : 'Which good practice from the debrief would you apply on a real server, and why?'}</li>
      </ol>
    </div>
  ))}
</section>

<details class="teacher-route">
  <summary>{fr ? 'Version enseignant·e : le chemin de solution (pas pour les élèves)' : "Teacher's version: the solution route (not for students)"}</summary>
  <p class="intro">
    {fr
      ? "Les étapes que le jeu vérifie, dans l'ordre, avec la piste puis la solution : ce sont les indices que le jeu donne lui-même à qui en demande trois. Le jeu vérifie le résultat, pas la commande : d'autres solutions passent. Ouverte, cette partie s'imprime aussi, sur une nouvelle page."
      : 'The steps the game checks, in order, with the lead then the solution: the same hints the game itself gives a player who asks for three. The game checks the result, not the command: other solutions pass. Once open, this part prints too, on a new page.'}
  </p>
  {sheets.map((f) => {
    const route = solutionRoute(f.chapter, t);
    return (
      <section class="route" aria-labelledby={`r-${f.chapter.id}`}>
        <h3 id={`r-${f.chapter.id}`}>{title(f.chapter.number, f.chapter.id)}</h3>
        {route.length ? (
          <ol>
            {route.map((r) => (
              <li>
                <p>{typo(r.lead)}</p>
                <pre tabindex="0"><code>{r.solution}</code></pre>
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">{fr ? "Pas d'indice pour ce chapitre : le débrief raconte la solution." : 'No hints for this chapter: the debrief tells the solution.'}</p>
        )}
      </section>
    );
  })}
</details>
<script>
  import '../interface/print';
</script>

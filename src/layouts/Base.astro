---
// Shared layout of the site's pages. Page texts live in the pages
// themselves: one page per language, English at /en/, French at /fr/;
// / picks one from the browser's language (see public/.htaccess).
// La police des titres et du terminal, servie par le site (JetBrains Mono, licence OFL).
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  // La même page dans une autre langue (lien en haut de page).
  other?: { href: string; lang: string; name: string };
}
const { title, description, lang = 'en', other } = Astro.props;
const en = lang !== 'fr';
const home = en ? '/en/' : '/fr/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#0e1319" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#eef2ee" media="(prefers-color-scheme: light)" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {other && <link rel="alternate" hreflang={other.lang} href={new URL(other.href, Astro.site)} />}
  {other && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}
</head>
<body>
  <header>
    <p class="nom"><a href={home}><span class="invite" aria-hidden="true">~$ </span>{en ? 'Sysadmin Quests' : 'Quêtes de Sysadmin'}<span class="curseur" aria-hidden="true"></span></a></p>
    {other && <p class="langue"><a href={other.href} hreflang={other.lang} lang={other.lang}>{other.name}</a></p>}
  </header>
  <main>
    <slot />
  </main>
  <footer>
    {en ? (
      <>
        <p>
          Inspired by <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html">Terminus</a>,
          created at MIT by Shawn Conrad and Michele Pratusevich: the idea of learning commands by moving
          from directory to directory comes from there; the places, puzzles and texts are our own. The
          addresses and domain names used are reserved for examples (RFC 5737, RFC 6761).
        </p>
        <p>
          Code under the <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin/blob/main/LICENSE">GPL v3</a>,
          texts under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
          <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin">Source code</a> ·
          a project by <a href="https://rouages.net" hreflang="fr">Les rouages du net</a>. No trackers, no ads.
        </p>
      </>
    ) : (
    <>
    <p>
      Inspiré de <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html" hreflang="en">Terminus</a>,
      créé au MIT par Shawn Conrad et Michele Pratusevich : l'idée d'apprendre les commandes en se
      déplaçant de dossier en dossier vient de là ; les lieux, les énigmes et les textes sont les nôtres.
      Les commandes répondent souvent en anglais, comme sur un vrai système ; les adresses et les noms
      de domaine utilisés sont réservés aux exemples (RFC 5737, RFC 6761).
    </p>
    <p>
      Code sous licence <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin/blob/main/LICENSE">GPL v3</a>,
      textes sous <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr">CC BY-SA 4.0</a>.
      <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin">Code source</a> ·
      un projet de <a href="https://rouages.net">Les rouages du net</a>. Sans pisteur ni publicité.
    </p>
    </>
    )}
  </footer>
</body>
</html>

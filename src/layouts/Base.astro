---
// Shared layout of the site's pages. Page texts live in the pages
// themselves: one page per language, English at /en/, French at /fr/;
// / picks one from the browser's language (see public/.htaccess).
// The font of the headings and the terminal, served by the site (JetBrains Mono, OFL licence).
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  // The same page in another language (link at the top of the page).
  other?: { href: string; lang: string; name: string };
}
const { title, description, lang = 'en', other } = Astro.props;
const en = lang !== 'fr';
const home = en ? '/en/' : '/fr/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const appName = en ? 'Sysadmin Quests' : 'Quêtes de Sysadmin';
// The footer's "Report a problem or an idea": opens the game's dialog (src/pwa/feedback-link.ts);
// on a page without the game, or without JavaScript, the game's page opens it (#report).
const report = en ? 'Report a problem or an idea' : 'Signaler un problème ou une idée';
// The first link of every page, shown when it has the focus: past the header, to the content.
const skip = en ? 'Skip to content' : 'Aller au contenu';
// The footer's "Install the game" (src/pwa/install.ts): its messages.
const install = en
  ? {
      label: 'Install the game',
      help: 'In Safari, tap the Share button, then "Add to Home Screen".',
      offline: 'Once installed, the game opens full screen and plays offline; your progress stays on this device.',
      installing: 'The game is being installed: it will appear with your apps.',
      installed: 'The game is installed.',
      dismissed: 'Installation cancelled. You can keep playing here.',
    }
  : {
      label: 'Installer le jeu',
      help: "Dans Safari, touche le bouton Partager, puis « Sur l'écran d'accueil ».",
      offline: "Une fois installé, le jeu s'ouvre en plein écran et marche hors ligne ; ta progression reste sur cet appareil.",
      installing: "Le jeu s'installe : il apparaîtra parmi tes applications.",
      installed: 'Le jeu est installé.',
      dismissed: 'Installation annulée. Tu peux continuer à jouer ici.',
    };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#0e1319" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#eef2ee" media="(prefers-color-scheme: light)" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href={`${home}manifest.webmanifest`} />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content={appName} />
  {other && <link rel="alternate" hreflang={other.lang} href={new URL(other.href, Astro.site)} />}
  {other && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}
</head>
<body>
  <a class="skip-link" href="#content">{skip}</a>
  <header>
    <p class="name"><a href={home}><span class="prompt" aria-hidden="true">~$ </span>{appName}<span class="cursor" aria-hidden="true"></span></a></p>
    {other && <p class="language"><a href={other.href} hreflang={other.lang} lang={other.lang}>{other.name}</a></p>}
  </header>
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <footer>
    <div class="install" data-install data-installing={install.installing} data-installed={install.installed} data-dismissed={install.dismissed} hidden>
      <button type="button" class="install-button" hidden>{install.label}</button>
      <details class="install-ios" hidden>
        <summary>{install.label}</summary>
        <p>{install.help} {install.offline}</p>
      </details>
      <p class="install-status" role="status" tabindex="-1"></p>
    </div>
    <p class="report"><a href={`${home}#report`} data-report>{report}</a></p>
    {en ? (
      <>
        <p>
          Inspired by <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html">Terminus</a>,
          created at MIT by Shawn Conrad and Michele Pratusevich: the idea of learning commands by moving
          from directory to directory comes from there; the places, puzzles and texts are our own. The
          addresses and domain names used are reserved for examples (RFC 5737, RFC 6761).
        </p>
        <p>
          Code under the <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin/blob/main/LICENSE">GPL v3</a>,
          texts under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
          <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin">Source code</a> ·
          a project by <a href="https://rouages.net" hreflang="fr">Les rouages du net</a>. No trackers, no ads.
        </p>
      </>
    ) : (
    <>
    <p>
      Inspiré de <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html" hreflang="en">Terminus</a>,
      créé au MIT par Shawn Conrad et Michele Pratusevich : l'idée d'apprendre les commandes en se
      déplaçant de dossier en dossier vient de là ; les lieux, les énigmes et les textes sont les nôtres.
      Les commandes répondent souvent en anglais, comme sur un vrai système ; les adresses et les noms
      de domaine utilisés sont réservés aux exemples (RFC 5737, RFC 6761).
    </p>
    <p>
      Code sous licence <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin/blob/main/LICENSE">GPL v3</a>,
      textes sous <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr">CC BY-SA 4.0</a>.
      <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin">Code source</a> ·
      un projet de <a href="https://rouages.net">Les rouages du net</a>. Sans pisteur ni publicité.
    </p>
    </>
    )}
  </footer>
  <script>
    import '../pwa/site';
  </script>
</body>
</html>

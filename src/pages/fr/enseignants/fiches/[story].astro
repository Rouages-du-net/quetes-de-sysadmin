---
// A story's printable sheet (src/components/StorySheet.astro), one page per story.
import Base from '../../../../layouts/Base.astro';
import StorySheet from '../../../../components/StorySheet.astro';
import { STORIES } from '../../../../engine/chapters';
import { loadAllTexts, translator } from '../../../../texts';

export function getStaticPaths() {
  return STORIES.map((h) => ({ params: { story: h.id } }));
}
const { story } = Astro.params;
await loadAllTexts();
const name = translator('fr')(`story-${story}`);
---
<Base
  title={`${name} : fiche à imprimer — Quêtes de Sysadmin`}
  lang="fr"
  description={`Une fiche à distribuer pour « ${name} » : l'objectif de chaque chapitre, les commandes et les pages du manuel, des questions pour vérifier ce qu'on a appris, et une version enseignant·e.`}
  other={{ href: `/en/teachers/sheets/${story}/`, lang: 'en', name: 'English' }}
>
  <StorySheet lang="fr" story={story!} />
</Base>

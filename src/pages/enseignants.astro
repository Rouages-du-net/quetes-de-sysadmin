---
// Les fiches pour les enseignant·es : une par chapitre (objectif, ce qu'il
// faut avoir fait avant, commandes découvertes, durée indicative), tirées
// des histoires elles-mêmes à la construction du site.
import Base from '../layouts/Base.astro';
import { HISTOIRES } from '../moteur/chapitres';
import { fiches } from '../moteur/fiches';
import { traducteur, typographie } from '../textes';

const t = traducteur('fr');
const typo = (texte: string) => typographie(texte, 'fr');
const toutes = fiches();
const total = toutes.reduce((s, f) => s + f.duree, 0);
const heures = (minutes: number) => (minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${String(minutes % 60).padStart(2, '0')}` : ''}`);
---
<Base
  titre="Pour les enseignant·es — Quêtes de Sysadmin"
  description="Les fiches des quêtes : objectifs, prérequis, commandes découvertes et durée indicative de chaque chapitre, pour préparer un cours ou un TP."
>
  <h1>Pour les enseignant·es</h1>
  <p class="intro">
    Chaque chapitre est une petite mission sur un serveur simulé, avec de vraies commandes. Le jeu
    vérifie le <strong>résultat</strong> sur l'état du système, pas la commande exacte : plusieurs
    solutions correctes passent, et chaque chapitre se termine par un débrief (ce qui s'est passé,
    la bonne pratique, la documentation officielle).
  </p>
  <p class="intro">
    {HISTOIRES.length} histoires, {toutes.length} chapitres, environ {heures(total)} en tout. Les durées
    sont indicatives (une dizaine de minutes pour s'installer, puis quelques minutes par étape
    vérifiée) : un groupe débutant prendra plus de temps.
  </p>

  <section aria-labelledby="organiser">
    <h2 id="organiser">Organiser une séance</h2>
    <ul class="intro">
      <li>
        <strong>Sans compte, sans installation</strong> : la progression reste dans le navigateur de
        chaque élève. Rien n'est envoyé nulle part.
      </li>
      <li>
        <strong>L'Effaceur d'abord</strong> : il apprend à se déplacer et donne les clés SSH des autres
        histoires. Pour ouvrir directement une autre histoire (un TP ciblé), intégrez le jeu avec son
        attribut <code>histoire</code> (voir chaque histoire ci-dessous).
      </li>
      <li>
        <strong>Rendre son travail</strong> : sous le terminal, le « carnet du sysadmin » se télécharge
        en Markdown. Il contient la progression (chapitres terminés) et les commandes utilisées, avec
        la première ligne tapée.
      </li>
      <li>
        <strong>Bloqué·e ?</strong> Le jeu renvoie vers <code>man</code>, <code>--help</code> et
        <code>man -k</code> plutôt que de donner la réponse : c'est le réflexe à faire prendre.
      </li>
    </ul>
  </section>

  {HISTOIRES.map((h) => {
    const liste = toutes.filter((f) => f.histoire === h);
    return (
      <section class="fiche-histoire" aria-labelledby={`h-${h.id}`}>
        <h2 id={`h-${h.id}`}>{t(`histoire-${h.id}`)}</h2>
        <p>{typo(t(`histoire-${h.id}.resume`))}</p>
        <p class="discret">
          {liste.length} {liste.length > 1 ? 'chapitres' : 'chapitre'}, environ {heures(liste.reduce((s, f) => s + f.duree, 0))}.
          {h.id !== 'effaceur' && ' Demande les clés données à la fin de l\'Effaceur, sauf en ouverture directe :'}
        </p>
        {h.id !== 'effaceur' && <pre><code>{`<quetes-de-sysadmin histoire="${h.id}"></quetes-de-sysadmin>`}</code></pre>}
        <ol class="fiches">
          {liste.map((f) => (
            <li class="fiche" id={`c-${f.chapitre.id}`}>
              <h3>{t('chapitre-numero', { numero: f.chapitre.numero })} : {t(`chapitre-${f.chapitre.id}`)}</h3>
              <dl>
                <dt>Objectif</dt>
                <dd>{typo(t(`chapitre-${f.chapitre.id}.resume`))}</dd>
                <dt>Avant</dt>
                <dd>{f.avant ? `« ${t(`chapitre-${f.avant.id}`)} »` : h.id === 'effaceur' ? 'Rien : on part de zéro.' : 'L\'Effaceur (ou une ouverture directe).'}</dd>
                <dt>Commandes découvertes</dt>
                <dd>{f.nouvelles.length ? f.nouvelles.map((c, i) => <>{i > 0 && ', '}<code>{c}</code></>) : 'Aucune nouvelle : on réutilise ce qu\'on connaît.'}</dd>
                <dt>Durée indicative</dt>
                <dd>{heures(f.duree)}</dd>
              </dl>
            </li>
          ))}
        </ol>
      </section>
    );
  })}
</Base>
